insereLista (int i, lista, nodo) {
	rdx = i
	r8 = endereço da lista 
	
	r9 = endereco do nodo atual (r8)
	r10 = endereço do ponteiro atual
	
	r11 = endereço do nodo inserido
	r12 = endereço do ponteiro inserido
	
	r13 = nodo passado
	
	if (r9 == 0) {
		(r8) = r11;
		(r12) = 0;
		return;
	}
	
	if (r9 > r11) {						// id da lista > id do inserido
		(r12) = r9;						// id da lista  = id do inserido
		(r8) = r11;
	} else {
		while (r9 < r11) {				// enquanto id atual < id inserido
			r13 = r9;
			r14 = r10
			r9 = (r10);
			r10 = r9 + 16;
			if ((r14) == 0) break;
		}
		(r12) = (r14)
		(r14) = r11
	}
	
	if (rdx == 0) {
		if (r9 == 0) jmp endereçosDiferentes;
		
		rax = r9 + 8;				// tamanho
		rbx = r9 + 24;
		rcx = rbx + (rax);
		rdx = (r10)					// proximo nodo
		if (rcx == rdx) {
			(rax) += 24;
			rbx = rdx + 8;			// proximo tamanho
			rcx = (rbx);
			(rax) += rcx;			// corrigiu o campo tamanho
			
			rax += 8;				// ponteiro atual
			rbx += 8;				// proximo ponteiro
			rcx = (rbx);
			(rax) = rcx;			// corrigiu o campo ponteiro
		}
		
		rax = r13 + 8;				// tamanho
		rbx = r13 + 24;
		rcx = rbx + (rax);
		if (rcx == r9) {
			(rax) += 24;
			rbx = r9 + 8;
			rcx = (rbx);
			(rax) += rcx;			// corrigiu o campo tamanho
			
			rax += 8;
			rbx += 8;
			rcx = (rbx);
			(rax) = rcx;			// corrigiu o campo ponteiro
		}
	}
	
	return;
}


